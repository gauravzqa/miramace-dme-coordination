# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# fake | live
MIRA_LLM_MODE=fake
# Opaque model id for text agents (caller, persona, extractor, LCD, companion)
MIRA_TEXT_MODEL=
# Per-turn model for call brains; defaults to MIRA_TEXT_MODEL when empty
MIRA_TURN_MODEL=
# Optional reasoning effort (e.g. low); empty = model default
MIRA_REASONING_EFFORT=
MIRA_STT_MODEL=gpt-4o-mini-transcribe
MIRA_TTS_MODEL=gpt-4o-mini-tts
MIRA_TTS_VOICE_CALLER=sage
MIRA_TTS_VOICE_PERSONA=coral
# 0 | 1
MIRA_VOICE=0
MIRA_VOICE_LEGS=pcp
MIRA_DEMO_ROOM=mira-pcp-call
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
